[
  {
    "context": "Workspace",
    "bindings": {
      "cmd-p": "command_palette.open",
      "cmd-t": "workspace_tab.create",
      "cmd-,": "settings.open",
      "cmd-1": ["workspace_tab.goto", { "index": 1 }],
      "cmd-2": ["workspace_tab.goto", { "index": 2 }],
      "cmd-3": ["workspace_tab.goto", { "index": 3 }],
      "cmd-4": ["workspace_tab.goto", { "index": 4 }],
      "cmd-5": ["workspace_tab.goto", { "index": 5 }],
      "cmd-6": ["workspace_tab.goto", { "index": 6 }],
      "cmd-7": ["workspace_tab.goto", { "index": 7 }],
      "cmd-8": ["workspace_tab.goto", { "index": 8 }],
      "cmd-9": ["workspace_tab.goto", { "index": 9 }],
      // "cmd-0": ["workspace_tab.goto", { "index": 0 }],
      "ctrl-tab": "workspace_tab.next",
      "ctrl-shift-tab": "workspace_tab.previous",

      "<leader> w n": "workspace.create",
      "<leader> w l": "workspace.next",
      "<leader> w h": "workspace.previous",
    },
  },
  {
    "context": "WorkspaceTab",
    "bindings": {
      "cmd-w": "pane.close",
      "ctrl-1": ["pane.focus_in_slot", { "index": 1 }],
      "ctrl-2": ["pane.focus_in_slot", { "index": 2 }],
      "ctrl-3": ["pane.focus_in_slot", { "index": 3 }],
      "ctrl-4": ["pane.focus_in_slot", { "index": 4 }],
      "ctrl-5": ["pane.focus_in_slot", { "index": 5 }],
      "ctrl-6": ["pane.focus_in_slot", { "index": 6 }],
      "ctrl-7": ["pane.focus_in_slot", { "index": 7 }],
      "ctrl-8": ["pane.focus_in_slot", { "index": 8 }],
      "ctrl-9": ["pane.focus_in_slot", { "index": 9 }],
      "cmd-opt-h": "pane.focus_left",
      "cmd-opt-j": "pane.focus_down",
      "cmd-opt-k": "pane.focus_up",
      "cmd-opt-l": "pane.focus_right",
      "cmd-shift-t": "terminal.new_pane",
      "cmd-d": "pane.split_right",
      "cmd-shift-d": "pane.split_down",

      "<leader> m h": "pane.move_left",
      "<leader> m j": "pane.move_down",
      "<leader> m k": "pane.move_up",
      "<leader> m l": "pane.move_right",
      "<leader> z": "pane.toggle_maximize",
      "<leader> n f": [
        "tool.nvim.open_file",
        {
          "path": "/Users/asyl/Documents/ibudo/docs/specs/2026-07-03-ibudo-terminal-context-04-completion.md",
          "mode": "current_window",
        },
      ],
      "<leader> s c": "snippets.open_create_modal",
      "<leader> s o": "workspace_tab.toggle_snippets_sidebar",
      "<leader> p s": "ssh.open_new_pane_modal",
      "<leader> p m": ["ssh.new_pane", { "host": "mini" }],
      "<leader> p b": "browser.open_url",
      "<leader> p c": "git.open_changes",
      "<leader> g g": "workspace_tab.toggle_git_sidebar",
    },
  },
  {
    "context": "TerminalPane",
    "bindings": {
      "cmd-k": ["input.send_key", { "key": "alt-z" }],
    },
  },
  // {
  //   "context": "SSHPane",
  //   "bindings": {
  //     "ctrl-h": null,
  //     "ctrl-j": null,
  //     "ctrl-k": null,
  //     "ctrl-l": null,
  //   },
  // },
  {
    "context": "BrowserPane",
    "bindings": {
      "cmd-[": "browser.back",
      "cmd-]": "browser.forward",
      "cmd-r": "browser.reload",
      "cmd-l": "browser.focus_address_bar",
    },
  },
  {
    "context": "GitPanel",
    "bindings": {
      "cmd-return": "git.commit",
      // "backspace": ["git.discard_selected", { "target": "selection" }],
    },
  },
]
